[Unit]
Description=WeatherTelegramAlerts poller
After=network-online.target weatheralerts-web.service
Wants=network-online.target

[Service]
Type=simple
User=weatheralerts
Group=weatheralerts
WorkingDirectory=/opt/weathertelegramalerts
ExecStart=/opt/weathertelegramalerts/.venv/bin/python /opt/weathertelegramalerts/WeatherAlerts.py -c /etc/weathertelegramalerts/config.yaml
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
