[Unit]
Description=WeatherTelegramAlerts unified service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weatheralerts
Group=weatheralerts
WorkingDirectory=/opt/WeatherTelegramAlerts
ExecStart=/opt/WeatherTelegramAlerts/.venv/bin/python /opt/WeatherTelegramAlerts/app.py -c /opt/WeatherTelegramAlerts/config.yaml
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
