[Unit]
Description=WeatherTelegramAlerts web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=weatheralerts
Group=weatheralerts
WorkingDirectory=/opt/WeatherTelegramAlerts
ExecStart=/opt/WeatherTelegramAlerts/.venv/bin/python /opt/WeatherTelegramAlerts/webapp.py -c /opt/WeatherTelegramAlerts/config.yaml --waitress
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
